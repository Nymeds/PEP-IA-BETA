DATABASE_URL="file:./dev.db"
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_EXTRACTION_DELTA_MODEL=gpt-4o-mini
OPENAI_FINAL_REVIEW_MODEL=gpt-4o
# false reativa a reinterpretação completa; true registra o delta sem preencher o PEP.
AI_PIPELINE_V2=true
AI_PIPELINE_V2_SHADOW=false
PORT=3000
FRONTEND_URL=http://localhost:3001
