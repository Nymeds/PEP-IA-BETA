# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_EXTRACTION_DELTA_MODEL=gpt-4o-mini
OPENAI_FINAL_REVIEW_MODEL=gpt-4o
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
OPENAI_DYNAMIC_INCREMENTAL_MODEL=gpt-5.6-terra
OPENAI_DYNAMIC_FINAL_MODEL=gpt-5.6-sol
OPENAI_DYNAMIC_INCREMENTAL_REASONING=low
OPENAI_DYNAMIC_FINAL_REASONING=medium
AI_PIPELINE_V2=true
AI_PIPELINE_V2_SHADOW=false
DYNAMIC_FORMS_PSYCHOLOGY=true

# Backend
PORT=3000
FRONTEND_URL=http://localhost:3001
JWT_SECRET=troque-por-uma-chave-longa-com-pelo-menos-32-caracteres
# 32 bytes em base64 ou 64 caracteres hexadecimais. Obrigatoria em producao.
DATA_ENCRYPTION_KEY=

# Database
DATABASE_URL="file:./dev.db"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DYNAMIC_FORMS_PSYCHOLOGY=true
